{
  "name": "conecta-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de jornadas simuladas do Conecta | Equipe 05",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "check:integration": "node scripts/check-integration.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  }
}
